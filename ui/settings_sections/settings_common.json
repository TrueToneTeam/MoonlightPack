{
  "namespace": "settings_common",

  // Luna Added
  "light_line_panel": {
    "$panel_size|default": [ "100%", "100%c + 14px" ],
    "$line_size|default": [ "100% - 30%", 1 ],

    "type": "panel",
    "size": "$panel_size",
    "controls": [
      {
        "section_divider": {
          "layer": 3,
          "type": "image",
          "size": "$line_size",
          "anchor_from": "center",
          "anchor_to": "center",
          "texture": "textures/ui/list_item_divider_line_light"
        }
      }
    ]
  },

  "light_line_horizontal_panel@setttings_common.light_line_panel": {
    // Base Size
  },

  "light_line_vertical_panel@settings_common.light_line_panel": {
    "$panel_size": [ 20, "100%" ],
    "$line_size|default": [ 2, "50%" ]
  },


  "subsection_title": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c + 10px" ],
    "$text|default": "",
    "controls": [
      {
        "spacer_0": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      },
      {
        "sizer_0": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "title": {
                "type": "label",
                "color": "$main_header_text_color",
                "text_alignment": "center",
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 3,
                "text": "$text"
              }
            }
          ]
        }
      },
      {
        "spacer_1": { "type": "panel", "size": [ "100%", 2 ] }
      },
      {
        "sizer_1": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "section_divider": {
                "type": "image",
                "size": [ "100% - 4px", 1 ],
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 3,
                "texture": "textures/ui/list_item_divider_line_light"
              }
            }
          ]
        }
      }
    ]
  },

  "new_options_design_base": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "$options_1|default": [],
    "$options_2|default": [],
    "controls": [
      {
        "options": {
          "type": "stack_panel",
          "size": [ "100%", "100%cm" ],
          "orientation": "horizontal",
          "controls": [
            { "options_1": { "type": "stack_panel", "size": [ "fill", "100%c" ], "orientation": "vertical", "controls": "$options_1" } },
            { "void_panel@common.empty_panel": { "size": [ 8, 0 ] } },
            { "options_2": { "type": "stack_panel", "size": [ "fill", "100%c" ], "orientation": "vertical", "controls": "$options_2" } }
          ]
        }
      }
    ]
  },

  "title_header": {
    "type": "label",
    "color": "$main_header_text_color",
    "shadow": true,
    "font_type": "MinecraftTen",
    "font_scale_factor": 1.6,
    "$title|default": "",
    "text": "$title"
  },

  "icon_with_text_border_base": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "$border_size|default": [ "100%", 38 ],
    "$border_color|default": [ 1.0, 1.0, 1.0 ],
    "$border_icon|default": "textures/ui/icon_none",
    "$border_icon_cover|default": "textures/ui/icon_none",
    "$border_icon_cover_visible|default": false,
    "$border_text|default": "",
    "controls": [
      {
        "info_text_panel": {
          "layer": 5,
          "type": "image",
          "size": "$border_size",
          "texture": "textures/ui/hud_text_background_white",
          "color": "$border_color",
          "controls": [
            {
              "content_stack": {
                "type": "stack_panel",
                "size": [ "100% - 8px", "100% - 8px" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "orientation": "horizontal",
                "controls": [
                  {
                    "icon_panel": {
                      "layer": 7,
                      "type": "panel",
                      "size": [ "100%y", "100%" ],
                      "controls": [
                        {
                          "icon": { "type": "image", "size": [ "90%", "90%" ], "anchor_from": "center", "anchor_to": "center", "texture": "$border_icon" }
                        },
                        {
                          "icon_cover": { "visible": "$border_icon_cover_visible", "type": "image", "size": [ "90% + 0.5px", "90% + 0.5px" ], "anchor_from": "center", "anchor_to": "center", "texture": "$border_icon_cover" }
                        }
                      ]
                    }
                  },
                  { "void_panel@common.empty_panel": { "size": [ 2, 0 ] } },
                  {
                    "text_panel": {
                      "type": "panel",
                      "size": [ "fill", "100%" ],
                      "controls": [
                        {
                          "text": {
                            "layer": 7,
                            "type": "label",
                            "size": [ "default", "default" ],
                            "max_size": [ "100%", "100%" ],
                            "anchor_from": "left_middle",
                            "anchor_to": "left_middle",
                            "text": "$border_text"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "ore_info_label_panel": {
    "type": "image",
    "texture": "textures/ui/text_label_box",
    "size": [ "100%", "100%c + 6px" ],
    "$used_fontsize|default": "normal",
    "$used_fonttype|default": "default",
    "controls": [
      {
        "control": {
          "layer": 1,
          "type": "label",
          "color": "$main_header_text_color",
          "size": [ "100% - 8px", "default" ],
          "text": "$container_text_binding_name",
          "text_alignment": "center",
          "font_size": "$used_fontsize",
          "font_type": "$used_fonttype",
          "bindings": [
            {
              "binding_name": "$container_text_binding_name"
            }
          ]
        }
      }
    ]
  },


  // Highlight Animation
  "icon_highlight": {
    "layer": 3,
    "type": "image",
    "texture": "textures/ui/ore/icon-highlight-spritesheet",
    "size": [ 24, 24 ],
    "uv_size": [ 24, 24 ],
    "uv": "@settings_common.icon_highlight_uv_animation",
    "disable_anim_fast_forward": true,
    "bilinear": true
  },

  "icon_highlight_uv_animation": {
    "anim_type": "flip_book",
    "initial_uv": [ 0, 0 ],
    "frame_count": 9,
    "frame_step": 1,
    "fps": 10,
    "reversible": false,
    "resettable": true
  },



  // Ore UI Design Options
  "ore_action_button@common_buttons.light_text_button": {
    "$pressed_button_name|default": "unset_button_name",
    "$button_text|default": "unset $button_text",
    "size": [ "100%", 30 ],
    "anchor_from": "center",
    "anchor_to": "center",

    "$new_sound_enabled|default": false,
    "variables": [
      {
        "requires": "$new_sound_enabled",
        "sound_name": "click_on.ore_button_click"
      }
    ],

    "$border_visible": false,
    "$button_image_size|default": [ "100%", "100%" ],
    "$button_offset|default": [ 0, -1 ],
    "$button_pressed_offset|default": [ 0, 2 ],

    "$default_text_color|default": "$light_button_default_text_color",
    "$hover_text_color|default": "$light_button_default_text_color",
    "$pressed_text_color|default": "$light_button_default_text_color",
    "$locked_text_color|default": "$light_button_locked_text_color",

    "$default_button_texture|default": "textures/ui/ore/button_borderless_light",
    "$hover_button_texture|default": "textures/ui/ore/button_borderless_lighthover",
    "$pressed_button_texture|default": "textures/ui/ore/button_borderless_lightpressed",
    "$locked_button_texture|default": "textures/ui/ore/disabledButtonNoBorder"
  },

  "ore_link_button@common_buttons.hyperlink_button": {
    "$button_text|default": "unset $button_text",
    "size": [ "100%", 30 ],
    "anchor_from": "center",
    "anchor_to": "center",

    "$new_sound_enabled|default": false,
    "variables": [
      {
        "requires": "$new_sound_enabled",
        "sound_name": "click_on.ore_button_click"
      }
    ],

    "$border_visible": false,
    "$button_image_size|default": [ "100%", "100%" ],
    "$button_offset|default": [ 0, -1 ],
    "$button_pressed_offset|default": [ 0, 2 ],

    "$default_text_color|default": "$light_button_default_text_color",
    "$hover_text_color|default": "$light_button_default_text_color",
    "$pressed_text_color|default": "$light_button_default_text_color",
    "$locked_text_color|default": "$light_button_locked_text_color",

    "$default_button_texture|default": "textures/ui/ore/button_borderless_light",
    "$hover_button_texture|default": "textures/ui/ore/button_borderless_lighthover",
    "$pressed_button_texture|default": "textures/ui/ore/button_borderless_lightpressed",
    "$locked_button_texture|default": "textures/ui/ore/disabledButtonNoBorder",

    "property_bag": {
      "#hyperlink": "unset #hyperlink in property_bag"
    }
  },

  "ore_option_dropdown@settings_common.option_generic": {
    "$ore_ui_design": true,
    "$control_name": "settings_common.upgrade_option_dropdown_control"
  },

  "ore_option_toggle@settings_common.option_generic": {
    "$control_name": "settings_common.ore_option_toggle_control",
    "$option_label|default": "",
    "$toggle_tts_header": "$option_label",
    "variables": [
      {
        "requires": "$desktop_screen",
        "$one_line_layout": true
      }
    ]
  },

  "ore_option_slider@settings_common.option_generic": {
    "$control_name": "settings_common.ore_option_slider_control"
  },


  // Upgrade Option & Ore UI Design
  "ore_option_slider_control": {
    "type": "panel",
    "size": [ "100% - 6px", 16 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "slider@common.slider": {
          "size": [ "100% - 8px", 8 ],
          "$slider_box_size": [ 16, 16 ],
          "offset": [ 0, 0 ],

          "$option_label|default": "",

          "$slider_tts_header": "$option_label",
          "$slider_tts_header_binding_type": "global",


          // Ore UI Design
          "$slider_box_layout|default": "settings_common.ore_slider_button_layout",
          "$slider_box_hover_layout|default": "settings_common.ore_slider_button_hover_layout",
          "$slider_box_locked_layout|default": "settings_common.ore_slider_button_locked_layout",
          "$slider_box_indent_layout|default": "settings_common.ore_slider_button_indent_layout",

          "$slider_step_factory_control_ids": {
            "slider_step": "@settings_common.ore_slider_step_progress",
            "slider_step_hover": "@settings_common.ore_slider_step_progress_hover",
            "slider_step_progress": "@settings_common.ore_slider_step",
            "slider_step_progress_hover": "@settings_common.ore_slider_step_hover"
          },
          "controls": [
            {
              "slider_box@settings_common.ore_slider_box": {
                "$slider_box_layout": "$slider_box_layout",
                "$slider_box_size": "$slider_box_size",
                "$slider_track_button": "$slider_name"
              }
            },
            {
              "slider_bar_default@settings_common.ore_slider_bar_default": {}
            },
            {
              "slider_bar_hover@settings_common.ore_slider_bar_hover": {
                "visible": false
              }
            }
          ],


          "enabled": "$enabled",
          "$slider_enabled_binding_name": "$option_enabled_binding_name",
          "$slider_enabled_binding_type": "global",
          "variables": [
            {
              "requires": "(not $option_enabled_binding_name or not $enabled)",
              "$slider_enabled_binding_name": "#not_data_bound",
              "$slider_enabled_binding_type": "none"
            }
          ]
        }
      }
    ]
  },

  "ore_slider_button_state": {
    "layer": 2,
    "type": "image",
    "texture": "textures/ui/ore/slider_button_default"
  },

  "ore_slider_button_layout@settings_common.ore_slider_button_state": {
    "texture": "textures/ui/ore/slider_button_default"
  },

  "ore_slider_button_hover_layout@settings_common.ore_slider_button_state": {
    "texture": "textures/ui/ore/slider_button_hover"
  },

  "ore_slider_button_locked_layout@settings_common.ore_slider_button_state": {
    "texture": "textures/ui/ore/slider_button_locked"
  },

  "ore_slider_button_indent_layout@settings_common.ore_slider_button_state": {
    "texture": "textures/ui/ore/slider_button_indent"
  },

  "ore_slider_box": {
    "type": "slider_box",
    "layer": 4,
    "size": "$slider_box_size",
    "anchor_to": "center",
    "anchor_from": "center",
    "default_control": "default",
    "hover_control": "hover",
    "locked_control": "locked",
    "indent_control": "indent",
    "controls": [
      {
        "default@$slider_box_layout": {
          "layer": 2
        }
      },
      {
        "hover@$slider_box_hover_layout": {
          "layer": 3
        }
      },
      {
        "indent@$slider_box_indent_layout": {
          "layer": 4
        }
      },
      {
        "locked@$slider_box_locked_layout": {
          "layer": 1,
          "controls": [
            {
              "transparent_grey": {
                "type": "image",
                "ignored": "$is_holographic",
                "texture": "textures/ui/ore/slider_locked_transparent_fade",
                "alpha": 0.5,
                "layer": 5,
                "bindings": [
                  {
                    "binding_type": "$slider_enabled_binding_type",
                    "binding_condition": "$slider_enabled_binding_condition",
                    "binding_collection_name": "$slider_collection_name",
                    "binding_name": "(not $slider_enabled_binding_name)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "ore_slider_background": {
    "type": "image",
    "texture": "textures/ui/ore/slider_background"
  },

  "ore_slider_background_hover": {
    "type": "image",
    "texture": "textures/ui/ore/slider_background_hover"
  },

  "ore_slider_progress": {
    "type": "image",
    "texture": "textures/ui/ore/slider_progress"
  },

  "ore_slider_progress_hover": {
    "type": "image",
    "texture": "textures/ui/ore/slider_progress_hover"
  },

  "ore_slider_border": {
    "type": "image",
    "texture": "textures/ui/ore/slider_border"
  },

  "ore_slider_bar_default@settings_common.ore_slider_border": {
    "$background_control|default": "settings_common.ore_slider_background",
    "$progress_control|default": "settings_common.ore_slider_progress",
    "$background_control_name|default": "slider_background",
    "$progress_control_name|default": "slider_progress",
    "$progress_clip_direction|default": "left",

    "color": "$slider_default_border_color",

    "controls": [
      {
        "sizing_panel": {
          "type": "panel",
          "size": [ "100% - 2px", "100% - 2px" ],
          "controls": [
            {
              "$background_control_name@$background_control": {
                "layer": 1
              }
            },
            {
              "$progress_control_name@$progress_control": {
                "layer": 3,
                "clip_direction": "$progress_clip_direction",
                "clip_pixelperfect": false
              }
            }
          ]
        }
      },
      {
        "transparent_grey": {
          "type": "image",
          "ignored": "$is_holographic",
          "texture": "textures/ui/ore/slider_locked_transparent_fade",
          "alpha": 0.5,
          "layer": 4,
          "bindings": [
            {
              "binding_type": "$slider_enabled_binding_type",
              "binding_condition": "$slider_enabled_binding_condition",
              "binding_collection_name": "$slider_collection_name",
              "binding_name": "(not $slider_enabled_binding_name)",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "ore_slider_bar_hover@settings_common.ore_slider_bar_default": {
    "color": "$slider_default_border_color",

    "$background_control": "settings_common.ore_slider_background_hover",
    "$progress_control": "settings_common.ore_slider_progress_hover",
    "$background_control_name": "slider_background_hover",
    "$progress_control_name": "slider_progress_hover"
  },

  "ore_slider_step": {
    "type": "image",
    "texture": "textures/ui/ore/slider_step_background",
    "size": [ 2, 2 ],
    "layer": 4,
    "offset": "$step_offset"
  },

  "ore_slider_step_hover@settings_common.ore_slider_step": {
    "texture": "textures/ui/ore/slider_step_background_hover"
  },

  "ore_slider_step_progress@settings_common.ore_slider_step": {
    "texture": "textures/ui/ore/slider_step_progress"
  },

  "ore_slider_step_progress_hover@settings_common.ore_slider_step": {
    "texture": "textures/ui/ore/slider_step_progress_hover"
  },


  "ore_option_toggle_control@common.toggle": {
    "layer": 2,
    "$toggle_state_binding_name|default": "$option_binding_name",
    "$toggle_enabled_binding_name|default": "$option_enabled_binding_name",
    "$toggle_enabled_binding_type|default": "global",
    "size": [ "100%", "100%c" ],
    "$binding_type": "global",
    "$binding_condition": "once",
    "$unchecked_control": "settings_common.ore_option_toggle_off",
    "$checked_control": "settings_common.ore_option_toggle_on",
    "$unchecked_hover_control": "settings_common.ore_option_toggle_off_hover",
    "$checked_hover_control": "settings_common.ore_option_toggle_on_hover",
    "$unchecked_locked_control": "settings_common.ore_option_toggle_off_locked",
    "$unchecked_locked_hover_control": "settings_common.ore_option_toggle_off_locked",
    "$checked_locked_control": "settings_common.ore_option_toggle_on_locked",
    "$checked_locked_hover_control": "settings_common.ore_option_toggle_on_locked",

    "$enable_directional_toggling": false,

    "enabled": "$enabled",
    "variables": [
      {
        "requires": "(not $option_enabled_binding_name or not $enabled)",
        "$toggle_enabled_binding_name": "#not_data_bound",
        "$toggle_enabled_binding_type": "none"
      }
    ]
  },

  "ore_option_toggle_on@settings_common.option_toggle_state_template": {
    "texture": "textures/ui/ore/toggle_on"
  },

  "ore_option_toggle_off@settings_common.option_toggle_state_template": {
    "texture": "textures/ui/ore/toggle_off"
  },

  "ore_option_toggle_on_hover@settings_common.option_toggle_state_template": {
    "texture": "textures/ui/ore/toggle_on_hover"
  },

  "ore_option_toggle_off_hover@settings_common.option_toggle_state_template": {
    "texture": "textures/ui/ore/toggle_off_hover"
  },

  "ore_option_toggle_on_locked@settings_common.option_toggle_state_template": {
    "texture": "textures/ui/ore/toggle_on_locked"
  },

  "ore_option_toggle_off_locked@settings_common.option_toggle_state_template": {
    "texture": "textures/ui/ore/toggle_off_locked"
  },



  "upgrade_option_dropdown@settings_common.option_generic": {
    "$control_name": "settings_common.upgrade_option_dropdown_control"
  },

  "upgrade_option_dropdown_control": {
    "type": "panel",
    "$option_dropdown_size|default": [ "100%", 28 ],
    "size": "$option_dropdown_size",
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 2,
    "$dropdown_background_control|default": "common.dropdown_background",
    "$option_dropdown_type|default": "common.dropdown",
    "$option_label|default": "",
    "$dropdown_content|default": "common.empty_panel",
    "controls": [
      {
        "dropdown@$option_dropdown_type": {
          "visible": false,
          "$dropdown_toggle": "settings_common.options_dropdown_toggle_control",
          "$dropdown_background": "$dropdown_background_control",
          "$dropdown_content|default": "unset_dropdown_content",
          "$dropdown_name|default": "unset $dropdown_name",
          "$options_dropdown_toggle_label_binding|default": "unset $options_dropdown_toggle_label_text",
          "$locked_alpha": 0.5,
          "$toggle_tts_header": "$option_label"
        }
      },
      {
        "content@$dropdown_content": {}
      }
    ]
  },

  "upgrade_option_radio_dropdown_group": {
    "type": "panel",
    "size": [ "100%", 32 ],
    "$toggle_tts_header": "",
    "$toggle_tts_name": "accessibility.dropdown.listItem",
    "$toggle_tts_toggle_on_text": "accessibility.state.selected",
    "$toggle_tts_toggle_off_text": "accessibility.state.unselected",
    "$toggle_tts_type_priority": 50,

    "controls": [
      {
        "group_control@settings_common.upgrade_option_radio_group_control": {
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },

  "upgrade_option_radio_group_control": {
    "type": "stack_panel",
    "size": [ "100%", 28 ],
    "orientation": "horizontal",
    "controls": "$radio_buttons",
    "$radio_factory|default": { "name": "empty" },
    "$radio_collection_name|default": "",
    "$radio_bindings|default": [],

    "factory": "$radio_factory",
    "collection_name": "$radio_collection_name",
    "bindings": "$radio_bindings"
  },

  "upgrade_radio_with_label": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "fill", 28 ],
    "offset": [ 0, 0 ],
    "$enabled|default": true,
    "controls": [
      { "radio_with_label_core@settings_common.upgrade_radio_with_label_core": {} }
    ]
  },

  "upgrade_radio_with_label_core@settings_common.radio_with_label_core": {
    "size": [ "100%", "100%" ],

    "$unchecked_control|default": "common_radios.upgrade_radio_unchecked",
    "$checked_control|default": "common_radios.upgrade_radio_checked",
    "$unchecked_hover_control|default": "common_radios.upgrade_radio_unchecked_hover",
    "$checked_hover_control|default": "common_radios.upgrade_radio_checked_hover",
    "$unchecked_locked_control|default": "common_radios.upgrade_radio_unchecked_locked",
    "$unchecked_locked_hover_control|default": "common_radios.upgrade_radio_unchecked_locked",
    "$checked_locked_control|default": "common_radios.upgrade_radio_checked_locked",
    "$checked_locked_hover_control|default": "common_radios.upgrade_radio_checked_locked",

    "$unchecked_radio_label_color|default": "$light_toggle_default_text_color",
    "$checked_radio_label_color|default": "$light_toggle_checked_default_text_color",
    "$unchecked_hover_radio_label_color|default": "$light_toggle_hover_text_color",
    "$checked_hover_radio_label_color|default": "$light_toggle_checked_hover_text_color",
    "$unchecked_locked_radio_label_color|default": "$light_toggle_default_text_color",
    "$checked_locked_radio_label_color|default": "$light_toggle_checked_default_text_color",

    "$default_button_texture|default": "textures/ui/button_borderless_light",
    "$hover_button_texture|default": "textures/ui/button_borderless_lighthover",
    "$pressed_button_texture|default": "textures/ui/button_borderless_lightpressed",
    "$pressed_no_hover_button_texture|default": "textures/ui/button_borderless_lightpressednohover",
